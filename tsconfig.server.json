{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node", "vitest/globals"],
    "noEmit": false,
